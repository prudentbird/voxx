# PostHog (visitor analytics, exception autocapture, web vitals) via @posthog/next.
# Client-side key — safe to expose; the provider reads it automatically.
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# PostHog ingestion host. Defaults to US Cloud when unset.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Keep the official site out of anonymous package telemetry: voxx-core reports a
# one-time `core_used` event per process, and the site has its own analytics above.
VOXX_TELEMETRY_DISABLED="1"

# Source map upload (de-minifies production stack traces in PostHog).
# Used only by the `postbuild` step on Vercel — not read by the app at runtime.
# When unset, the upload step is skipped. Set both in the Vercel project's
# environment variables (Production), not in committed files.
# Personal API key with error-tracking write scope (PostHog → Settings → Personal API keys).
POSTHOG_CLI_API_KEY="phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Target PostHog environment/project ID to associate the uploaded maps with.
POSTHOG_CLI_ENV_ID="00000"
