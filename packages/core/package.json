{
  "name": "@prudentbird/voxx-core",
  "version": "1.2.0",
  "description": "The portable content engine behind Voxx: markdown + frontmatter -> SEO-ready blogs, docs, and changelogs.",
  "license": "MIT",
  "author": "prudentbird <me@prudentbird.com> (https://prudentbird.com)",
  "homepage": "https://github.com/prudentbird/voxx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prudentbird/voxx.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/prudentbird/voxx/issues"
  },
  "keywords": [
    "cms",
    "markdown",
    "blog",
    "docs",
    "changelog",
    "static-site",
    "seo",
    "rss",
    "llms-txt",
    "effect"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "theme",
    "voxx.schema.json",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.mts",
        "default": "./dist/effect.mjs"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.mts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./theme/voxx.css": "./theme/voxx.css",
    "./theme/demo-globals.css": "./theme/demo-globals.css",
    "./voxx.schema.json": "./voxx.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node ./scripts/gen-schema.ts",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsgo --pretty --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.107.0",
    "@shikijs/rehype": "^4.2.0",
    "effect": "^3.21.3",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.3",
    "@typescript/native-preview": "7.0.0-dev.20260610.1",
    "@voxx/eslint-config": "workspace:*",
    "@voxx/typescript-config": "workspace:*",
    "eslint": "^10.0.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
