{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NO_COLOR",
    "CI",
    "DO_NOT_TRACK",
    "VOXX_TELEMETRY_DISABLED",
    "XDG_STATE_HOME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "voxx.schema.json"],
      "env": [
        "NODE_ENV",
        "SKIP_ENV_VALIDATION",
        "NEXT_RUNTIME",
        "VOXX_PUBLIC_POSTHOG_KEY",
        "VOXX_CORE_VERSION",
        "VOXX_VERSION"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
